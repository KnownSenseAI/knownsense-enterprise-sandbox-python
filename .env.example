# KnownSense sandbox API base
KENSO_API_BASE=https://audio.knownsense.ai

# Sandbox API key generated from the sandbox workspace in dashboard settings
KENSO_API_KEY=

# Webhook signing secret shown when you create or rotate the webhook endpoint
KENSO_WEBHOOK_SECRET=

# Optional: local receiver event log used by --verify-webhooks in the smoke suite
KENSO_WEBHOOK_EVENT_LOG=./data/received_events.jsonl

# Local receiver settings
KENSO_WEBHOOK_HOST=127.0.0.1
KENSO_WEBHOOK_PORT=8787
KENSO_WEBHOOK_PATH=/webhooks/knownsense
KENSO_WEBHOOK_MAX_SKEW_SECONDS=300
